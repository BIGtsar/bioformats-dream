cat > Dockerfile << 'EOF'
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY bioformats-dream/code/ ./code/

RUN echo '#!/bin/sh\n\
case "$1" in\n\
    fasta) exec python /app/code/fasta/fasta_analyzer.py ;;\n\
    fastq) exec python /app/code/fastq/fastq_analyzer.py ;;\n\
    sam)   exec python /app/code/sam/sam_demo.py ;;\n\
    vcf)   exec python /app/code/vcf/vcf_demo.py ;;\n\
    *)     echo "Usage: bioformats-dream {fasta|fastq|sam|vcf}" && exit 1 ;;\n\
esac\n' > /usr/local/bin/bioformats-dream && chmod +x /usr/local/bin/bioformats-dream

ENTRYPOINT ["bioformats-dream"]
CMD []
EOF
